<Window x:Class="WpfVarik3.Views.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVarik3.Views"
        mc:Ignorable="d"
        Title="EditOrderWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Товар:"/>
            <ComboBox x:Name="ProductComboBox" DisplayMemberPath="ProductName" 
                      Margin="0,0,0,10"/>

            <TextBlock Text="Статус:"/>
            <ComboBox x:Name="StatusComboBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Обработка"/>
                <ComboBoxItem Content="Доставка"/>
                <ComboBoxItem Content="Завершен"/>
            </ComboBox>

            <TextBlock Text="Адрес доставки:"/>
            <TextBox x:Name="AddressTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Дата заказа:"/>
            <DatePicker x:Name="OrderDatePicker" Margin="0,0,0,10"/>

            <TextBlock Text="Дата выдачи:"/>
            <DatePicker x:Name="DeliveryDatePicker" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Click="Save_Click" Margin="0,0,10,0" Width="80"/>
                <Button Content="Отмена" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
