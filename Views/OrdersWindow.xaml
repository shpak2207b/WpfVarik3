<Window x:Class="WpfVarik3.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVarik3.Views"
        mc:Ignorable="d"
        Title="OrdersWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" x:Name="OrdersListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Артикул" DisplayMemberBinding="{Binding Product.ProductId}" Width="80"/>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding Product.ProductName}" Width="150"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="100"/>
                    <GridViewColumn Header="Адрес доставки" DisplayMemberBinding="{Binding DeliveryAddress}" Width="200"/>
                    <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <GridViewColumn Header="Дата выдачи" DisplayMemberBinding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Добавить заказ" Click="AddOrder_Click" Margin="0,0,10,0"/>
            <Button x:Name="EditOrderBtn" Content="Редактировать" Click="EditOrder_Click" Margin="0,0,10,0"/>
            <Button x:Name="DeleteOrderBtn" Content="Удалить" Click="DeleteOrder_Click" Margin="0,0,10,0"/>
            <Button Content="Назад" Click="Back_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="RoleTextBlock" VerticalAlignment="Center"/>
        </StackPanel>


    </Grid>
</Window>