<Window x:Class="WpfVarik3.Views.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVarik3.Views"
        mc:Ignorable="d"
        Title="EditProductWindow" Height="500" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Название:"/>
            <TextBox x:Name="NameTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,10"/>

            <TextBlock Text="Производитель:"/>
            <ComboBox x:Name="SupplierComboBox" Margin="0,0,0,10"/>

            <TextBlock Text="Цена:"/>
            <TextBox x:Name="PriceTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Скидка (%):"/>
            <TextBox x:Name="DiscountTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Количество на складе:"/>
            <TextBox x:Name="QuantityTextBox" Margin="0,0,0,20"/>



            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Click="SaveButton_Click" Margin="0,0,10,0" Width="80"/>
                <Button Content="Отмена" Click="CloseButton_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>